{
  "manifest_version": 2,
  "name": "MeetCraft",
  "version": "0.1.0",
  "description": "Connects your Google Meet tab to the MeetCraft Minecraft mod: the theatre screen and the Meet mic key.",
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "permissions": [
    "https://meet.google.com/*",
    "<all_urls>",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "meet.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "meetcraft@meetcraft.dev",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
